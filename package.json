{
  "name": "mediaflow-proxy",
  "version": "3.3.0",
  "private": true,
  "description": "Proxy/stream server robusto para archivos grandes, URLs externas, cookies y cache.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "render-build": "echo \"no build step\"",
    "prestart": "node -v && npm ls --depth=0 || true"
  },
  "engines": {
    "node": "18.x"
  },
  "dependencies": {
